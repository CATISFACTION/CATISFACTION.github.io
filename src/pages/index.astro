---
import { getCollection } from "astro:content";
import { ArrowRight } from "@lucide/astro";
import ContactLinks from "../components/ContactLinks.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import profile from "../data/profile.json";
import { featuredProjects } from "../lib/projects";

const projects = featuredProjects(await getCollection("projects"));
---

<BaseLayout title={`${profile.name} | ${profile.role}`} description={profile.intro}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy" data-reveal>
        <p class="eyebrow">{profile.role}</p>
        <h1 class="display">{profile.name}</h1>
        <p class="hero-headline">{profile.heroHeadline}</p>
        <p class="body-large">{profile.intro}</p>
        <div class="hero-actions">
          <a class="button" href="/projects/">
            View projects
            <ArrowRight size={17} aria-hidden="true" />
          </a>
          <a class="button secondary" href="/contact/">Start a conversation</a>
        </div>
      </div>
      <figure class="hero-image" data-reveal data-reveal-delay="0.12">
        <img src={profile.profilePhoto.src} alt={profile.profilePhoto.alt} decoding="async" />
      </figure>
    </div>
  </section>

  <section class="section featured">
    <div class="container">
      <SectionHeading
        eyebrow="Selected work"
        title="Interior imagery with quiet structure and atmosphere."
        copy="A focused collection of residential, hospitality, workspace, and adaptive reuse studies."
      />
      <div class="featured-grid" data-stagger>
        {projects.map((project) => <ProjectCard project={project} featured />)}
      </div>
    </div>
  </section>

  <section class="section about-preview">
    <div class="container about-grid">
      <div data-reveal>
        <p class="eyebrow">Approach</p>
        <h2 class="headline">Visualization as a design instrument, not decoration.</h2>
      </div>
      <div class="about-copy" data-reveal data-reveal-delay="0.1">
        <p>{profile.bio}</p>
        <a class="text-link" href="/about/">
          More about the studio
          <ArrowRight size={16} aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <section class="section contact-preview">
    <div class="container contact-grid">
      <div data-reveal>
        <p class="eyebrow">Contact</p>
        <h2 class="subheadline">{profile.availability}</h2>
      </div>
      <div data-reveal data-reveal-delay="0.1">
        <ContactLinks />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    min-height: calc(100svh - 76px);
    display: grid;
    align-items: center;
    padding-block: clamp(56px, 8vw, 96px);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
    align-items: end;
    gap: clamp(2rem, 7vw, 6rem);
  }

  .hero-copy {
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.7rem);
  }

  .hero-headline {
    max-width: 760px;
    margin: 0;
    font-family: "Iowan Old Style", Georgia, serif;
    font-size: clamp(1.55rem, 4vw, 3.55rem);
    line-height: 1.05;
  }

  .hero .body-large {
    max-width: 650px;
    margin: 0;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 0.5rem;
  }

  .hero-image {
    position: relative;
    aspect-ratio: 4 / 5;
    width: min(100%, 430px);
    margin: 0 0 0 auto;
    overflow: hidden;
    background: var(--surface-muted);
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured {
    border-top: 1px solid var(--line);
    background: var(--surface);
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.4rem, 3vw, 2.3rem);
  }

  .about-preview {
    border-top: 1px solid var(--line);
  }

  .about-grid,
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.72fr);
    gap: clamp(2rem, 7vw, 6rem);
  }

  .about-copy {
    display: grid;
    align-content: start;
    gap: 1.5rem;
    color: var(--text-muted);
    font-size: 1.04rem;
    line-height: 1.8;
  }

  .about-copy p {
    margin: 0;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    width: fit-content;
    color: var(--text);
    font-weight: 800;
  }

  .text-link:hover {
    color: var(--accent-strong);
  }

  .contact-preview {
    border-top: 1px solid var(--line);
    background: var(--surface-muted);
  }

  @media (max-width: 880px) {
    .hero {
      min-height: auto;
    }

    .hero-grid,
    .about-grid,
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .hero-image {
      width: min(100%, 520px);
      margin: 0;
    }

    .featured-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
