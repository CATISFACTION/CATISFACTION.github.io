---
import { ArrowLeft } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="The requested portfolio page could not be found.">
  <section class="not-found">
    <div class="container" data-reveal>
      <p class="eyebrow">404</p>
      <h1 class="headline">This view is not in the set.</h1>
      <p class="body-large">The page may have moved, or the project slug may have changed in the CMS.</p>
      <a class="button" href="/projects/">
        <ArrowLeft size={17} aria-hidden="true" />
        Back to projects
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: calc(100svh - 76px);
    display: grid;
    align-items: center;
    padding-block: clamp(72px, 12vw, 150px);
  }

  .container {
    display: grid;
    gap: 1.2rem;
    max-width: 760px;
  }

  .body-large {
    margin: 0 0 1rem;
  }
</style>
