---
import BaseLayout from "../layouts/BaseLayout.astro";
import profile from "../data/profile.json";
---

<BaseLayout title="About" description={profile.bio} image={profile.profilePhoto.src}>
  <section class="page-hero">
    <div class="container hero-grid">
      <div data-reveal>
        <p class="eyebrow">About</p>
        <h1 class="headline">A refined visual practice for interiors before they exist.</h1>
      </div>
      <p class="body-large" data-reveal data-reveal-delay="0.1">{profile.bio}</p>
    </div>
  </section>

  <section class="section profile-section">
    <div class="container profile-grid">
      <figure data-reveal>
        <img src={profile.profilePhoto.src} alt={profile.profilePhoto.alt} loading="lazy" decoding="async" />
      </figure>
      <div class="profile-content" data-reveal data-reveal-delay="0.1">
        <p class="eyebrow">Experience</p>
        <ul class="experience-list">
          {profile.experience.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section expertise">
    <div class="container expertise-grid">
      <div data-reveal>
        <p class="eyebrow">Skills</p>
        <h2 class="subheadline">Design judgement, visual clarity, and presentation craft.</h2>
      </div>
      <div class="list-columns" data-stagger>
        <div>
          <h3>Services</h3>
          <ul>
            {profile.skills.map((skill) => <li data-stagger-item>{skill}</li>)}
          </ul>
        </div>
        <div>
          <h3>Software</h3>
          <ul>
            {profile.software.map((software) => <li data-stagger-item>{software}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(72px, 13vw, 160px) clamp(48px, 8vw, 96px);
  }

  .hero-grid,
  .profile-grid,
  .expertise-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.74fr);
    gap: clamp(2rem, 7vw, 6rem);
  }

  .body-large {
    margin: 0;
  }

  .profile-section {
    border-top: 1px solid var(--line);
    background: var(--surface);
  }

  figure {
    aspect-ratio: 4 / 5;
    margin: 0;
    overflow: hidden;
    background: var(--surface-muted);
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .experience-list {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    color: var(--text-muted);
    font-size: 1.04rem;
    line-height: 1.75;
    list-style: none;
  }

  .experience-list li {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .expertise {
    border-top: 1px solid var(--line);
  }

  .list-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  h3 {
    margin: 0 0 1rem;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .list-columns ul {
    display: grid;
    gap: 0.72rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .list-columns li {
    color: var(--text-muted);
  }

  @media (max-width: 820px) {
    .hero-grid,
    .profile-grid,
    .expertise-grid,
    .list-columns {
      grid-template-columns: 1fr;
    }
  }
</style>

