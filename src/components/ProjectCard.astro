---
import { ArrowUpRight } from "@lucide/astro";
import type { Project } from "../lib/projects";
import { projectUrl } from "../lib/projects";

interface Props {
  project: Project;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const data = project.data;
---

<article class:list={["project-card", { featured }]} data-stagger-item>
  <a href={projectUrl(project)} aria-label={`View project ${data.title}`}>
    <figure>
      <img src={data.coverImage.src} alt={data.coverImage.alt} loading="lazy" decoding="async" />
    </figure>
    <div class="project-card-content">
      <div>
        <p class="project-meta">{data.category ?? "Project"} / {data.year ?? "Selected work"}</p>
        <h2>{data.title}</h2>
      </div>
      <ArrowUpRight size={20} aria-hidden="true" />
    </div>
    <p>{data.excerpt}</p>
  </a>
</article>

<style>
  .project-card a {
    display: grid;
    gap: 1rem;
  }

  figure {
    position: relative;
    aspect-ratio: 4 / 3;
    margin: 0;
    overflow: hidden;
    background: var(--surface-muted);
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 700ms ease;
  }

  .project-card a:hover img {
    transform: scale(1.035);
    filter: contrast(1.03);
  }

  .project-card-content {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }

  h2 {
    margin: 0.25rem 0 0;
    font-family: "Iowan Old Style", Georgia, serif;
    font-size: clamp(1.45rem, 3vw, 2.2rem);
    font-weight: 400;
    line-height: 1.05;
  }

  .project-meta {
    margin: 0;
    color: var(--accent-strong);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .project-card > a > p {
    max-width: 58ch;
    margin: 0;
    color: var(--text-muted);
    line-height: 1.7;
  }

  svg {
    flex: 0 0 auto;
    color: var(--text-muted);
    transition:
      transform 220ms ease,
      color 220ms ease;
  }

  .project-card a:hover svg {
    color: var(--accent-strong);
    transform: translate(3px, -3px);
  }

  .featured figure {
    aspect-ratio: 16 / 10;
  }
</style>
